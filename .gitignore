# Python environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build outputs
dist/
build/work/

# Local wizard state and configuration (never commit secrets)
.env
wg.env
.axion-wizard-state.json
nginx/certs/
axion-wizard.log

# Backups: they carry the whole database and the WireGuard keys, which is to
# say everything the lines above protect.
backups/

# Timestamped backups the wizard itself writes before regenerating a file:
# the ones for `.env` and `wg.env` contain the secrets.
*.bak

# `axion.toml` for unattended mode: it carries the WireGuard panel credentials
# and, optionally, the PostgreSQL password.
axion.toml

# Local handover notes: they carry the state of one specific machine (LAN IP,
# paths, hardware, `.wslconfig`) and a dated work log. None of that belongs in
# a public repository. What was durable now lives in docs/troubleshooting.md.
CONTEXTO.md
