# Without this, `core.autocrlf=true` (the usual setting in Git for Windows)
# converts line endings to CRLF on checkout. A shell script with CRLF has a
# broken shebang (`#!/usr/bin/env bash\r`) and Linux does not recognise it:
# "env: bash\r: No such file or directory". It really happened with
# build/build.sh while operating the repo from Windows.
*.sh text eol=lf
*.py text eol=lf
*.j2 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
Makefile text eol=lf
LICENSE text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.png binary
*.exe binary
