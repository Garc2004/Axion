# Generated by axion-wizard. The managed services' sections are regenerated on
# every `install`/`doctor --fix`; any service added by hand outside that list
# is preserved.
# WireGuard variant: {{ wireguard_variant }}

services:
  postgres:
    image: {{ postgres_image }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: mattermost
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: mattermost
    labels:
      # Copying a running PostgreSQL's data directory produces an archive that
      # may not restore: the backup service stops this container while it
      # archives and starts it again afterwards. See the `backup` service.
      docker-volume-backup.stop-during-backup: axion
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - edge_net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U mattermost"]
      interval: 10s
      timeout: 5s
      retries: 5

  mattermost:
    image: {{ mattermost_image }}
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      MM_SQLSETTINGS_DRIVERNAME: postgres
      MM_SQLSETTINGS_DATASOURCE: "postgres://mattermost:${POSTGRES_PASSWORD}@postgres:5432/mattermost?sslmode=disable&connect_timeout=10"
      MM_SERVICESETTINGS_SITEURL: "https://{{ host }}"
      # Allowed origins for the WebSocket. Mattermost compares the `Origin`
      # header against the SiteURL before accepting the upgrade and returns
      # 403 if they differ — with no CORS involved and nothing in the logs.
      #
      # The failure this prevents is among the worst to diagnose: opening the
      # stack from the machine itself with `https://localhost`, the page loads
      # and works, but real time is dead. New messages — the AI's answer
      # included — only appear on pressing F5, because that reload re-fetches
      # them over ordinary HTTP, which is allowed.
      #
      # Specific origins are listed, never `*`: that would open the WebSocket
      # to any internet page the browser happened to have open.
      MM_SERVICESETTINGS_ALLOWCORSFROM: "https://{{ host }} https://localhost https://127.0.0.1"
      # Without this, Mattermost's SSRF protection blocks the webhook to
      # fastapi:8000 silently: no error appears in any log (spec §4.5). The
      # value comes from `s05_compose.SSRF_ENV_VALUE`, which is also what
      # `assert_ssrf_env_present` checks the generated file against. Writing it
      # here by hand let the two copies drift apart silently.
      MM_SERVICESETTINGS_ALLOWEDUNTRUSTEDINTERNALCONNECTIONS: "{{ ssrf_allowed_connections }}"
      # How long Mattermost waits for the outgoing webhook to answer. The
      # default is 30 s, and on CPU that runs out quickly: measured on the
      # reference machine (i3-10100F, no GPU), qwen2.5:3b generates 4.6
      # tokens/s, so a 200-token answer takes ~43 s. Past the deadline
      # Mattermost abandons the request and the answer is lost **whole**: the
      # user sees their question unanswered and no error appears in any log.
      #
      # It does not replace asynchronous mode (`axion-wizard set-bot-token`),
      # which removes the wait entirely; it is what makes a slow model usable
      # while that token is not configured.
      MM_SERVICESETTINGS_OUTGOINGINTEGRATIONREQUESTSTIMEOUT: "{{ outgoing_webhook_timeout }}"
    labels:
      # Stopped alongside PostgreSQL during the backup: a consistent database
      # is not much use if the uploaded files it references were archived at a
      # different instant.
      docker-volume-backup.stop-during-backup: axion
    volumes:
      - mattermost_data:/mattermost/data
      - mattermost_logs:/mattermost/logs
      - mattermost_config:/mattermost/config
      - mattermost_plugins:/mattermost/plugins
      - mattermost_client_plugins:/mattermost/client/plugins
    networks:
      - edge_net
    healthcheck:
      # curl, not wget: the official mattermost-team-edition image does not
      # ship wget, so that healthcheck always failed with "executable file not
      # found in $PATH" — Docker marked the container "unhealthy" forever,
      # even though the server answered perfectly from the inside.
      test: ["CMD", "curl", "-fsS", "http://localhost:8065/api/v4/system/ping"]
      interval: 15s
      timeout: 5s
      retries: 10

  ollama:
    image: {{ ollama_image }}
    restart: unless-stopped
    # Published on loopback only: it lets the wizard (running on the host)
    # query /api/tags and /api/pull directly, without exposing it to the LAN.
    ports:
      - "127.0.0.1:11434:11434"
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - edge_net
{%- if gpu_acceleration == "nvidia" %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
{%- elif gpu_acceleration == "rocm" %}
    # AMD does not go through NVIDIA's runtime: the GPU is handed over as two
    # kernel devices. `/dev/kfd` is the compute driver and `/dev/dri` the
    # render node; both are needed.
    devices:
      - /dev/kfd
      - /dev/dri
    # Without membership of these groups, the process inside the container
    # opens the devices and gets "permission denied" — Ollama does not fail, it
    # falls back to CPU silently, which is exactly what this exists to
    # prevent.
    group_add:
      - video
      - render
{%- endif %}

  fastapi:
    build:
      context: ./fastapi
    restart: unless-stopped
    environment:
      OLLAMA_HOST: "http://ollama:11434"
      OLLAMA_MODEL: ${OLLAMA_MODEL}
      # The AI's standing instructions (tone, language, what it should and
      # should not do). Empty = the model answers from its own training. Edit
      # with `axion-wizard model prompt "<text>"`.
      OLLAMA_SYSTEM_PROMPT: ${OLLAMA_SYSTEM_PROMPT:-}
      # Empty by default: Mattermost only generates this token when the
      # outgoing webhook is created, after deployment (see .env). With it
      # empty the bridge validates nothing — the same behaviour as before this
      # field existed.
      MM_WEBHOOK_TOKEN: ${MM_WEBHOOK_TOKEN:-}
      # With a bot token, the bridge answers the webhook immediately and posts
      # the reply through the API once the model finishes. Without it, it falls
      # back to synchronous mode, where Mattermost gives up after ~30s and a
      # slow model's answer is lost whole (see fastapi/main.py).
      MM_BOT_TOKEN: ${MM_BOT_TOKEN:-}
      MM_URL: "http://mattermost:8065"
      # Only matters in asynchronous mode (with MM_BOT_TOKEN set). It is asked
      # for alongside the bot token in step 9.
      AI_REPLY_IN_THREAD: ${AI_REPLY_IN_THREAD:-true}
    depends_on:
      - ollama
    networks:
      - edge_net
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]
      interval: 15s
      timeout: 5s
      retries: 10

  nginx:
    image: {{ nginx_image }}
    restart: unless-stopped
    ports:
      - "443:443"
      - "80:80"
    volumes:
      - ./nginx/nginx-mattermost.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx/certs:/etc/nginx/certs:ro
    depends_on:
      - mattermost
    networks:
      - edge_net

{% if wireguard_variant == "host" -%}
  # Native Linux: `network_mode: host` makes 10.8.0.1 a real host address that
  # reaches nginx directly. The sysctls go on the host
  # (/etc/sysctl.d/99-wireguard.conf), not here (§6.1).
  wireguard:
    image: {{ wireguard_image }}
    restart: unless-stopped
    network_mode: host
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    env_file:
      - wg.env
    volumes:
      - wireguard_data:/etc/wireguard
{%- else -%}
  # Windows / Docker Desktop: `network_mode: host` would point at Docker
  # Desktop's internal VM, not at WSL or at Windows — hence publishing the
  # ports explicitly, with Mattermost reached through the host's LAN address
  # rather than through 10.8.0.1 (§6.1).
  wireguard:
    image: {{ wireguard_image }}
    restart: unless-stopped
    ports:
      - "51820:51820/udp"
      - "51821:51821/tcp"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      net.ipv4.conf.all.src_valid_mark: 1
    env_file:
      - wg.env
    volumes:
      - wireguard_data:/etc/wireguard
    networks:
      - edge_net
{%- endif %}

  backup:
    image: {{ backup_image }}
    restart: unless-stopped
    environment:
      BACKUP_CRON_EXPRESSION: ${BACKUP_CRON_EXPRESSION}
      # `%Y%m%dT%H%M%S` is expanded by the service itself (strftime), not Compose.
      BACKUP_FILENAME: axion-%Y%m%dT%H%M%S.tar.gz
      BACKUP_RETENTION_DAYS: ${BACKUP_RETENTION_DAYS}
      # Without a prefix, age-based pruning would reach any file in the
      # destination, including things this service did not put there.
      BACKUP_PRUNING_PREFIX: axion-
      # A value of its own rather than the default `true`: that way only
      # AXION's containers are stopped, and not any other container on the
      # machine that happened to carry the label.
      BACKUP_STOP_DURING_BACKUP_LABEL: axion
    volumes:
      # Read-only: this service archives, it never writes to the data.
      - postgres_data:/backup/postgres_data:ro
      - mattermost_data:/backup/mattermost_data:ro
      - mattermost_config:/backup/mattermost_config:ro
      - mattermost_plugins:/backup/mattermost_plugins:ro
      - mattermost_client_plugins:/backup/mattermost_client_plugins:ro
      - wireguard_data:/backup/wireguard_data:ro
      # n8n's workflows and its encrypted credentials. Without this, a restore
      # would bring back the entire chat but leave n8n empty.
      - n8n_data:/backup/n8n_data:ro
      # `ollama_data` is deliberately left out: gigabytes of model that can be
      # re-pulled with `axion-wizard model set`. So is `mattermost_logs`:
      # there is nothing to restore in a log.
      - ./backups:/archive
      # Needed in order to stop and restart the labelled containers.
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - edge_net

  n8n:
    image: {{ n8n_image }}
    restart: unless-stopped
    environment:
      # If this key changes, EVERY credential n8n has stored becomes
      # unreadable and there is no way to recover them. That is why it lives in
      # the `.env` and is in PRESERVED_ENV_KEYS: generated once and surviving
      # any later `install`.
      N8N_ENCRYPTION_KEY: ${N8N_ENCRYPTION_KEY}
      N8N_HOST: "{{ host }}"
      N8N_PORT: 5678
      # http and not https on purpose: n8n is published on its own port and
      # does not go through nginx, so nobody terminates TLS for it. Announcing
      # itself as https would make it generate webhook URLs that do not answer.
      # It gets the same treatment as the WireGuard panel.
      N8N_PROTOCOL: http
      WEBHOOK_URL: "http://{{ host }}:5678/"
      GENERIC_TIMEZONE: ${N8N_TIMEZONE}
    volumes:
      - n8n_data:/home/node/.n8n
    ports:
      - "5678:5678"
    networks:
      - edge_net

volumes:
  postgres_data:
  mattermost_data:
  mattermost_logs:
  mattermost_config:
  mattermost_plugins:
  mattermost_client_plugins:
  ollama_data:
  wireguard_data:
  n8n_data:

networks:
  edge_net:
    driver: bridge
