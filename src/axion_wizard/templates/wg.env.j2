# Generado por axion-wizard. NO subir este archivo a control de versiones.
#
# Configuración de wg-easy v15. La v14 se configuraba con WG_HOST y un
# PASSWORD_HASH de bcrypt; la v15 es una reescritura completa que los ignora
# por completo, sin un solo aviso en sus logs.
#
# LAS VARIABLES INIT_* SOLO SE APLICAN EN EL PRIMER ARRANQUE, cuando el
# volumen `wireguard_data` todavía está vacío. A partir de ahí wg-easy tiene
# su propia base de datos y estas líneas no hacen nada: cambiar la contraseña
# aquí y reiniciar NO la cambia en el panel. Es el mismo comportamiento que
# POSTGRES_PASSWORD, y el mismo motivo por el que el wizard reutiliza lo que
# ya hubiera escrito en vez de regenerarlo.
#
# INIT_USERNAME e INIT_PASSWORD van juntos (el "grupo 1" de la documentación
# de wg-easy) junto con INIT_HOST e INIT_PORT: o se ponen los cuatro, o el
# panel arranca en su asistente web y espera a que alguien lo rellene a mano.
INIT_ENABLED=true
INIT_USERNAME={{ wireguard_admin_username }}
INIT_PASSWORD={{ wireguard_admin_password }}
INIT_HOST={{ host }}
INIT_PORT=51820
INIT_DNS=1.1.1.1

# Puerto del panel web. El wizard lo publica en el compose y lo usa para
# construir http://<host>:51821, así que no se cambia por libre.
PORT=51821

# Sin esto, wg-easy v15 se niega a servir por HTTP y el panel no responde.
# El stack lo publica en la LAN detrás del mismo nginx que el resto, pero el
# panel en sí no va por TLS: por eso su URL se construye siempre con http://
# explícito (ver `services/wireguard.py`).
INSECURE=true
