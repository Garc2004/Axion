# Generado por axion-wizard. NO subir este archivo a control de versiones.
#
# PASSWORD_HASH es un hash bcrypt y contiene '$' ($2b$12$...). Docker Compose
# SÍ interpola los valores de `env_file:` — al contrario de lo que se asumía
# aquí—, así que un '$' sin escapar se interpreta como el principio de una
# variable: `$2b$12$GktCd...` se convertía en `$2b$12.96FL219a`, y wg-easy
# recibía un hash destrozado con el que ninguna contraseña podía funcionar.
# El fallo era mudo: el panel arrancaba y simplemente rechazaba el login.
#
# `$$` es la forma documentada de escribir un '$' literal en Compose. El paso
# 6 lo verifica leyendo el valor de vuelta del contenedor, así que si alguna
# versión de Compose no interpolara este archivo, se detecta en el acto en
# vez de acabar otra vez en un panel que no deja entrar.
WG_HOST={{ host }}
PASSWORD_HASH={{ wireguard_admin_password_hash | replace("$", "$$") }}
WG_DEFAULT_ADDRESS=10.8.0.x
WG_DEFAULT_DNS=1.1.1.1
WG_PORT=51820
