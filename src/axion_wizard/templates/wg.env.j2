# Generated by axion-wizard. DO NOT commit this file to version control.
#
# wg-easy v15 configuration. v14 was configured with WG_HOST and a bcrypt
# PASSWORD_HASH; v15 is a ground-up rewrite that ignores both entirely,
# without a single warning in its logs.
#
# THE INIT_* VARIABLES ONLY APPLY ON THE FIRST START, while the
# `wireguard_data` volume is still empty. From then on wg-easy has its own
# database and these lines do nothing: changing the password here and
# restarting does NOT change it in the panel. It is the same behaviour as
# POSTGRES_PASSWORD, and the same reason the wizard reuses whatever it had
# already written rather than regenerating it.
#
# INIT_USERNAME and INIT_PASSWORD go together (wg-easy's documented "group 1")
# along with INIT_HOST and INIT_PORT: either all four are set, or the panel
# comes up in its web setup wizard and waits for somebody to fill it in.
INIT_ENABLED=true
INIT_USERNAME={{ wireguard_admin_username }}
INIT_PASSWORD={{ wireguard_admin_password }}
INIT_HOST={{ host }}
INIT_PORT=51820
INIT_DNS=1.1.1.1

# Web panel port. The wizard publishes it in the compose file and uses it to
# build http://<host>:51821, so it is not to be changed freely.
PORT=51821

# Without this, wg-easy v15 refuses to serve over HTTP and the panel does not
# answer at all. The stack publishes it on the LAN behind the same nginx as
# everything else, but the panel itself does not run over TLS: hence its URL
# always being built with an explicit http:// (see `services/wireguard.py`).
INSECURE=true
