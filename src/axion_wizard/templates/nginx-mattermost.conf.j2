# Generated by axion-wizard.

# `Connection: upgrade` should only go on the request that genuinely asks to
# upgrade to a WebSocket ($http_upgrade non-empty) — pinning it to "upgrade"
# for every request (as the previous version did) asks ordinary HTTP requests
# to switch protocol when they should not, and stops nginx reusing the
# keepalive connection to the backend in those cases.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker assigns a container a new IP every time it is recreated, and every
# time it is stopped and started again. nginx resolves the names in an
# `upstream` block **exactly once**, when it loads its configuration, and
# holds on to that IP forever: the moment Mattermost changes address, the
# whole stack returns 502 until somebody restarts nginx by hand.
#
# This is not hypothetical, and the wizard fixing it is not enough: the backup
# service stops and restarts Mattermost every night through Docker's API,
# without going anywhere near here. Without this, the stack was broken by
# morning and no healthcheck noticed — they all check each container from the
# inside, and none of them goes through nginx.
#
# `proxy_pass` only re-resolves the name when the address contains a variable,
# and that requires declaring a `resolver`: Docker's internal DNS, which on
# any user-defined network listens on 127.0.0.11. The price is losing the
# keepalive connection pool to the backend, which at this number of users is
# not noticeable.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name {{ host }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ host }};

    ssl_certificate     /etc/nginx/certs/cert.crt;
    ssl_certificate_key /etc/nginx/certs/cert.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100M;

    location / {
        # The variable is what forces nginx to re-resolve (see the `resolver`
        # above); with the name written literally it would go back to keeping
        # the first IP. `$request_uri` is mandatory: as soon as `proxy_pass`
        # carries a variable, nginx stops forwarding the original URI on its
        # own.
        set $mattermost_backend http://mattermost:8065;
        proxy_pass $mattermost_backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket (Mattermost real-time messaging).
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # TCP socket-level keepalive towards the backend. Mattermost's
        # WebSocket spends most of its time idle, waiting for a message to
        # arrive, and any intermediate layer that expires idle connections
        # (NAT conntrack, WSL2's mirrored networking — moby/moby#48201) cuts
        # it silently: the connection stays "open" as far as both ends are
        # concerned and nothing ever arrives again. The symptom is that new
        # messages only appear after pressing F5. Without this, nginx sends no
        # traffic over an idle connection and neither end has any way to
        # notice the break.
        proxy_socket_keepalive on;
    }
}
