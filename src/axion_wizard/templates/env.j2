# Generado por axion-wizard. NO subir este archivo a control de versiones.
#
# Nombre de proyecto de Compose. Docker Compose lee esta variable de este
# mismo archivo (comportamiento nativo, sin nada especial que hacer) y con
# ella prefija los contenedores y volúmenes (`{{ compose_project_name }}_postgres_data`,
# etc.). Generado una sola vez y conservado en cada `install` posterior.
#
# NUNCA copiar este valor a otro despliegue, ni escribirlo a mano: dos
# instalaciones con el mismo nombre de proyecto comparten los mismos
# contenedores y volúmenes en el mismo host Docker, y cada `install`
# sobrescribe la configuración de la otra en silencio. Pasó de verdad: una
# instalación nueva generó una contraseña de PostgreSQL distinta y dejó a
# Mattermost sin poder autenticarse contra un volumen ya inicializado con la
# vieja — los contenedores de una instalación se mezclaron con los datos de
# otra sin que nada lo avisara hasta que Mattermost entró en bucle de
# reinicio.
COMPOSE_PROJECT_NAME={{ compose_project_name }}
POSTGRES_PASSWORD={{ postgres_password }}
OLLAMA_MODEL={{ ollama_model }}
MM_SITEURL=https://{{ host }}
# Instrucciones permanentes de la IA: tono, idioma, qué es y qué no debe
# hacer. Vacío = el modelo responde según su propio entrenamiento.
# No editar a mano: `axion-wizard model prompt "<texto>"` lo escribe aquí y
# recrea el contenedor de fastapi, que es lo que hace que el cambio aplique.
OLLAMA_SYSTEM_PROMPT={{ ollama_system_prompt }}
# Token del webhook saliente de Mattermost — Mattermost lo genera al crear el
# webhook (Integraciones > Webhooks salientes), después de que este stack ya
# está desplegado, así que el wizard no puede rellenarlo de antemano.
# Aplícalo con `axion-wizard set-webhook-token <token>`, que lo escribe aquí y
# recrea fastapi (pegarlo a mano no basta: las variables de entorno se fijan al
# crear el contenedor). Vacío = sin validar: cualquiera dentro de la red de
# Docker puede llamar al webhook.
MM_WEBHOOK_TOKEN={{ mm_webhook_token }}
# Token de un bot de Mattermost (Integraciones > Bots). Con él, el puente
# contesta al webhook al instante y publica la respuesta cuando el modelo
# termina, así que da igual lo que tarde. Sin él, Mattermost abandona la
# petición a los ~30s y la respuesta de un modelo lento se pierde entera.
# Aplícalo con `axion-wizard set-bot-token <token>`.
MM_BOT_TOKEN={{ mm_bot_token }}
# Copias de seguridad automáticas (servicio `backup`). Se guardan en la
# carpeta `backups/` de este mismo directorio, en formato tar.gz.
#
# Durante la copia se paran PostgreSQL y Mattermost —unos segundos— y se
# vuelven a arrancar solos: copiar una base de datos en marcha produce un
# archivo que puede no restaurar. De ahí que la hora por defecto sea de
# madrugada. Editar estos dos valores y aplicar con `axion-wizard up backup`;
# `install` los conserva.
#
# NO cubre `ollama_data` (gigabytes de modelo que se vuelven a descargar) ni
# los logs de Mattermost.
BACKUP_CRON_EXPRESSION={{ backup_cron_expression }}
# Días que se conservan las copias. 0 las conserva todas —y el disco se acaba
# llenando—; el borrado solo alcanza a los archivos que empiezan por `axion-`.
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
# Clave con la que n8n cifra las credenciales que guardas en sus flujos.
# Solo se usa si instalaste n8n (`axion-wizard install --with-n8n`).
#
# NO cambiarla ni borrarla: si cambia, todas las credenciales guardadas quedan
# ilegibles y no hay forma de recuperarlas — n8n arranca igual y los flujos
# fallan al autenticarse, sin decir por qué. `install` la conserva.
N8N_ENCRYPTION_KEY={{ n8n_encryption_key }}
# Zona horaria de los cron de n8n. Tiene que ser un nombre IANA
# (`America/Argentina/Buenos_Aires`, `Europe/Madrid`), no uno de Windows: con
# un valor que no reconozca, n8n se queda en UTC y los flujos programados
# disparan a otra hora sin avisar. `install` conserva lo que pongas.
N8N_TIMEZONE={{ n8n_timezone }}
