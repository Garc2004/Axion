# Generated by axion-wizard. DO NOT commit this file to version control.
#
# Compose project name. Docker Compose reads this variable from this very
# file (native behaviour, nothing special to do) and uses it to prefix the
# containers and volumes (`{{ compose_project_name }}_postgres_data`, and so
# on). Generated once and preserved by every later `install`.
#
# NEVER copy this value to another deployment, or write it by hand: two
# installs sharing a project name share the same containers and volumes on
# the same Docker host, and each `install` silently overwrites the other's
# configuration. This really happened: a fresh install generated a different
# PostgreSQL password and left Mattermost unable to authenticate against a
# volume already initialised with the old one — one install's containers got
# mixed up with another's data, with nothing to warn anybody until Mattermost
# went into a restart loop.
COMPOSE_PROJECT_NAME={{ compose_project_name }}
POSTGRES_PASSWORD={{ postgres_password }}
OLLAMA_MODEL={{ ollama_model }}
MM_SITEURL=https://{{ host }}
# The AI's standing instructions: tone, language, what it is and what it must
# not do. Empty = the model answers from its own training.
# Do not edit by hand: `axion-wizard model prompt "<text>"` writes it here and
# recreates the fastapi container, which is what makes the change take effect.
OLLAMA_SYSTEM_PROMPT={{ ollama_system_prompt }}
# Mattermost's outgoing webhook token — Mattermost generates it when the
# webhook is created (Integrations > Outgoing Webhooks), after this stack is
# already deployed, so the wizard cannot fill it in beforehand.
# Apply it with `axion-wizard set-webhook-token <token>`, which writes it here
# and recreates fastapi (pasting it by hand is not enough: environment
# variables are fixed when the container is created). Empty = unvalidated:
# anyone inside the Docker network can call the webhook.
MM_WEBHOOK_TOKEN={{ mm_webhook_token }}
# A Mattermost bot token (Integrations > Bot Accounts). With it, the bridge
# answers the webhook immediately and posts the reply once the model finishes,
# so however long it takes does not matter. Without it, Mattermost abandons
# the request after ~30s and a slow model's answer is lost whole.
# Apply it with `axion-wizard set-bot-token <token>`.
MM_BOT_TOKEN={{ mm_bot_token }}
# Automatic backups (the `backup` service). They are stored in the `backups/`
# folder of this same directory, as tar.gz archives.
#
# During the backup, PostgreSQL and Mattermost are stopped — for a few seconds
# — and started again on their own: copying a running database produces an
# archive that may not restore. Hence the default hour being in the small
# hours. Edit these two values and apply with `axion-wizard up backup`;
# `install` preserves them.
#
# It does NOT cover `ollama_data` (gigabytes of model that can be re-pulled)
# or Mattermost's logs.
BACKUP_CRON_EXPRESSION={{ backup_cron_expression }}
# Days the backups are kept. 0 keeps them all — and the disk eventually fills
# up; the pruning only ever touches files beginning with `axion-`.
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
# The key n8n encrypts the credentials stored in its workflows with.
#
# DO NOT change or delete it: if it changes, every stored credential becomes
# unreadable and there is no way to recover them — n8n starts up regardless
# and the workflows fail to authenticate, without saying why. `install`
# preserves it.
N8N_ENCRYPTION_KEY={{ n8n_encryption_key }}
# Timezone for n8n's cron jobs. It has to be an IANA name
# (`America/Argentina/Buenos_Aires`, `Europe/Madrid`), not a Windows one: with
# a value it does not recognise, n8n stays on UTC and scheduled workflows fire
# at a different hour without warning. `install` keeps whatever you set.
N8N_TIMEZONE={{ n8n_timezone }}
# Only has an effect in asynchronous mode (with MM_BOT_TOKEN set): whether the
# AI's reply hangs off the message that triggered it (a thread, collapsed
# until clicked) or is posted as a normal channel message. `true`/`false`.
# It is asked for alongside the bot token in step 9; changing it afterwards
# takes a recreate: axion-wizard up fastapi.
AI_REPLY_IN_THREAD={{ ai_reply_in_thread }}
